# Copy this file to ".env" and keep ONLY ONE line filled in.
# Easiest free option: Gemini (https://aistudio.google.com/apikey) or Groq (https://console.groq.com/keys)

GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: force one model name (Gemini default: gemini-3.5-flash-lite)
# LLM_MODEL=

# Speed settings — run `node diagnose.js` and it tells you what to put here:
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_THINKING_BUDGET=0
